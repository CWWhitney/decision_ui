Arithmetic {
  Exp
    = AddExp

  AddExp
    = AddExp "+" MulExp  -- plus
    | AddExp "-" MulExp  -- minus
    | MulExp

  MulExp
    = MulExp "*" ExpExp  -- times
    | MulExp "/" ExpExp  -- divide
    | MulExp "%" ExpExp  -- modulo
    | ExpExp

  ExpExp
    = PriExp "^" ExpExp  -- power
    | PriExp

  PriExp
    = "(" Exp ")"  -- paren
    | "-" PriExp   -- neg
    | FuncExp
    | variable
    | number

  FuncExp
    = #(funcName "(") FuncArgs ")"

  FuncArgs
    = Exp ("," Exp)*

  funcName  (a function)
    = "chance_event"
    | "vv"
    | "npv"
    | "abs"
    | "ceiling"
    | "floor"
    | "sin"
    | "cos"
    | "tan"
    | "exp"
    | "log"
    | "log10"
    | "round"
    |  "trunc"
    | "sqrt"

  variable  (a variable)
    = variableStart variableContinue*

  variableStart
    = letter

  variableContinue
    = variableStart | digit | "_"

  number  (a number)
    = digit* "." digit+  -- fract
    | digit+             -- whole
}