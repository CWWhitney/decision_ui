{
    "name": "@decision-support-ui/common",
    "version": "0.3.0",
    "description": "common types and functions",
    "author": "Thomas Low <code@thomaslow.com>",
    "private": true,
    "main": "build/cjs/src/index.js",
    "module": "build/esm/src/index.js",
    "types": "build/esm/src/index.d.ts",
    "scripts": {
        "build": "npm run build-ohm && npm run build-esm && npm run build-cjs",
        "build-esm": "tsc -p tsconfig.esm.json",
        "build-cjs": "tsc -p tsconfig.cjs.json",
        "build-ohm": "ohm generateBundles --withTypes --esm \"src/**/*.ohm\"",
        "watch": "concurrently -c auto -n ohm,esm,cjs \"npm run watch-ohm\" \"npm run watch-esm\" \"npm run watch-cjs\"",
        "watch-esm": "tsc -p tsconfig.esm.json --watch --preserveWatchOutput",
        "watch-cjs": "tsc -p tsconfig.cjs.json --watch --preserveWatchOutput",
        "watch-ohm": "nodemon -w ./src -e ohm -x npm run build-ohm",
        "lint": "eslint src"
    },
    "dependencies": {
        "ajv": "^8.18.0",
        "awesome-ajv-errors": "^5.1.0",
        "csv-parse": "6.2.1",
        "gaussian": "^1.3.0",
        "@tensorflow/tfjs": "4.22.0",
        "ohm-js": "^17.5.0"
    },
    "devDependencies": {
        "@ohm-js/cli": "^2.0.1",
        "@types/gaussian": "^1.2.2",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.4",
        "nodemon": "^3.1.14",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.58.0",
        "vite-plugin-node-polyfills": "^0.26.0"
    }
}
