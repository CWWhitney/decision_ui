{
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "node",
        "target": "es6",
        "outDir": "build",
        "declaration": true,
        "rootDir": ".",
        "allowJs": true,
        "newLine": "LF",
        "noImplicitAny": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "lib": ["ES2021", "DOM"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.ohm-bundle.js", "unknown.d.ts"]
}
