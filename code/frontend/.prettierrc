{
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "fluid": false,
    "vueIndentScriptAndStyle": true,
    "arrowParens": "avoid",
    "overrides": [{ "files": "**/*.{yaml,yml}", "options": { "tabWidth": 2 } }]
}
