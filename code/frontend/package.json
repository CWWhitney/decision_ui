        "vue": "3.5.32",
        "vue3-excel-editor": "^1.0.60",
        "vue-router": "^5.0.4",
        "vue-chartjs": "^5.3.3",
        "vuetify": "^3.12.5",
        "pinia": "^3.0.4"
