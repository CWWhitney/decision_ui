        "@types/file-saver": "^2.0.7",
        "@types/gaussian": "^1.2.2",
        "electron": "^41.1.1",
        "electron-builder": "^26.8.1",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-vue": "^10.8.0",
        "eslint-plugin-vuetify": "^2.7.2",
        "npm-run-all2": "^8.0.4",
        "prettier": "^3.8.1",
        "sass-embedded": "^1.99.0",
