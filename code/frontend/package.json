{
    "name": "@decision-support-ui/frontend",
    "version": "0.2.1",
    "author": "Institute of Crop Science and Resource Conservation, University of Bonn",
    "description": "A tool to support decision making using Monte Carlo simulations",
    "private": true,
    "type": "module",
    "main": "./dist/electron/vite/main/index.js",
    "scripts": {
        "watch:webapp": "vite --host",
        "watch:electron": "electron-vite dev",
        "start": "vite preview --host",
        "unit": "jest --config test/unit/jest.conf.js --coverage",
        "test": "npm run unit",
        "lint": "eslint src test/unit",
        "build": "vite build",
        "build:electron:linux": "electron-vite build && electron-builder --linux",
        "build:electron:win": "electron-vite build && electron-builder --win",
        "analyze": "vite-bundle-visualizer"
    },
    "dependencies": {
        "@decision-support-ui/common": "file:../common",
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@highlightjs/vue-plugin": "^2.1.0",
        "@sgratzl/chartjs-chart-boxplot": "^4.4.5",
        "@tensorflow/tfjs": "4.22.0",
        "@vue-flow/core": "^1.48.1",
        "@vue-flow/background": "^1.3.2",
        "@vue-flow/minimap": "^1.5.4",
        "@vue-flow/node-resizer": "^1.5.0",
        "@vue-flow/node-toolbar": "^1.1.1",
        "@vueuse/core": "^14.1.0",
        "axios": "^1.13.2",
        "baklavajs": "2.6.0",
        "chart.js": "^4.5.1",
        "csv-parse": "6.1.0",
        "file-saver": "^2.0.5",
        "gaussian": "^1.3.0",
        "jszip": "^3.10.1",
        "@d4c/numjs": "^0.17.34",
        "markdown-it": "^14.1.0",
        "markdown-it-replace-link": "^1.2.2",
        "vue": "3.5.26",
        "vue3-excel-editor": "^1.0.60",
        "vue-router": "^4.6.4",
        "vue-chartjs": "^5.3.3",
        "vuetify": "^3.11.6",
        "pinia": "^3.0.4"
    },
    "devDependencies": {
        "@electron-toolkit/tsconfig": "^2.0.0",
        "jest": "^29.7.0",
        "jest-serializer-vue": "^3.1.0",
        "@vue/vue3-jest": "^29.2.6",
        "@tsconfig/node24": "^24.0.3",
        "@types/node": "^25.0.3",
        "@types/markdown-it": "^14.1.2",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vitejs/plugin-vue-jsx": "^5.1.3",
        "@vitejs/plugin-legacy": "^7.2.1",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.6.0",
        "@vue/tsconfig": "^0.8.1",
        "@types/chart.js": "^4.0.1",
        "@types/file-saver": "^2.0.7",
        "@types/gaussian": "^1.2.2",
        "electron": "^39.2.7",
        "electron-builder": "^26.4.0",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.2",
        "eslint-plugin-vue": "^10.6.2",
        "eslint-plugin-vuetify": "^2.5.3",
        "npm-run-all2": "^8.0.4",
        "prettier": "^3.7.4",
        "sass-embedded": "^1.97.2",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-vue-devtools": "^8.0.5",
