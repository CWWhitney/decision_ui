{
    "name": "@decision-support-ui/frontend",
    "version": "0.4.0",
    "author": "Institute of Crop Science and Resource Conservation, University of Bonn",
    "description": "A tool to support decision making using Monte Carlo simulations",
    "private": true,
    "type": "module",
    "main": "./dist/electron/vite/main/index.js",
    "scripts": {
        "watch:webapp": "vite --host",
        "watch:electron": "electron-vite dev",
        "start": "vite preview --host",
        "unit": "jest --config test/unit/jest.conf.js --coverage",
        "test": "npm run unit",
        "lint": "eslint src",
        "build": "vite build",
        "build:electron:linux": "electron-vite build && electron-builder --linux",
        "build:electron:win": "electron-vite build && electron-builder --win",
        "analyze": "vite-bundle-visualizer"
    },
